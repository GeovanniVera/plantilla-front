# Test-only environment (Vitest runs with mode=test).
# Not secrets: every VITE_ variable ends up in the public bundle.
# The unit and storybook projects share one Vitest run, so this file covers both.
# VITE_API_BASE must stay absolute (cross-origin): the API client tests assume it,
# see src/lib/api/client.test.ts.
VITE_API_BASE=http://localhost:8080/api
VITE_AUTH_LOGIN_PATH=/auth/login
VITE_AUTH_REFRESH_PATH=/auth/refresh
VITE_AUTH_LOGOUT_PATH=/auth/logout
VITE_AUTH_ME_PATH=/auth/me
VITE_REQUEST_TIMEOUT=15000
VITE_APP_NAME=SemillaTecnologica
